; Engine configuration file for Seedshot (Jamference Hack 4).
; It is easiest to edit this through Project > Project Settings in the Godot editor,
; but the sections are plain text:
;   [application]  name + which scene starts first
;   [autoload]     scripts that are always loaded (global helpers)
;   [display]      window size and how it scales in a browser
;   [input]        the action names the scripts use (move_left, fire, vine, ...)
;   [layer_names]  human names for the 2D physics layers
;   [rendering]    Compatibility renderer = WebGL2, the safest choice for web builds

config_version=5

[application]

config/name="Seedshot"
config/description="A gardener-bot plants a forest out of the machines it shoots down."
run/main_scene="res://scenes/arena.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

